rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Fal metinleri: herkes okuyabilir, yazma sadece Admin SDK ile (upload_fortunes.py)
    match /fortunes/{fortuneId} {
      allow read: if true;
      allow write: if false;
    }

    // Niyet paylaşımları
    match /posts/{postId} {
      allow read: if true;

      // Yeni gönderi: giriş (anonim dahil) gerekli, alanlar ve boyutlar sınırlı
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['authorUid', 'mysticName', 'avatarEmoji', 'intentionText',
              'timestamp', 'likeCount', 'likedBy'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.intentionText is string
        && request.resource.data.intentionText.size() >= 1
        && request.resource.data.intentionText.size() <= 280
        && request.resource.data.mysticName is string
        && request.resource.data.mysticName.size() <= 40
        && request.resource.data.avatarEmoji is string
        && request.resource.data.avatarEmoji.size() <= 16
        && request.resource.data.timestamp is int
        && request.resource.data.likeCount == 0
        && request.resource.data.likedBy.size() == 0;

      // Beğeni: sadece likeCount ve likedBy değişir, kullanıcı yalnızca kendi UID'sini
      // ekleyip çıkarabilir ve sayaç tam 1 değişir
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likeCount', 'likedBy'])
        && (
          // beğen
          (
            !(request.auth.uid in resource.data.likedBy)
            && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1
            && request.resource.data.likedBy.hasAll(resource.data.likedBy)
            && request.auth.uid in request.resource.data.likedBy
            && request.resource.data.likeCount == resource.data.likeCount + 1
          )
          ||
          // beğeniyi geri al
          (
            request.auth.uid in resource.data.likedBy
            && request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1
            && resource.data.likedBy.hasAll(request.resource.data.likedBy)
            && !(request.auth.uid in request.resource.data.likedBy)
            && request.resource.data.likeCount == resource.data.likeCount - 1
          )
        );

      // Kullanıcı yalnızca kendi gönderisini silebilir (hesap silme akışı)
      allow delete: if request.auth != null
        && resource.data.authorUid == request.auth.uid;
    }

    // Şikayetler: yalnızca oluşturulabilir (kullanıcı başına gönderi başına bir kez), istemci okuyamaz
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['postId', 'authorUid', 'reporterUid', 'reason', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.authorUid is string
        && reportId == request.auth.uid + '_' + request.resource.data.postId
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 40
        && request.resource.data.createdAt is int;
      allow read, update, delete: if false;
    }

    // Davet kodları: sahibi kendi kodunu oluşturur. Arkadaş katılımı alt koleksiyonda tutulur,
    // sayaç yok (sahibi sayıyı count() ile okur), kendi kodunla katılamazsın, katılım silinemez/güncellenemez.
    match /invites/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt is int
        && code.size() == 6;
      allow update, delete: if false;

      match /joins/{joinerUid} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/invites/$(code)).data.ownerUid == request.auth.uid;
        allow create: if request.auth != null
          && joinerUid == request.auth.uid
          && get(/databases/$(database)/documents/invites/$(code)).data.ownerUid != request.auth.uid
          && request.resource.data.keys().hasOnly(['joinedAt'])
          && request.resource.data.joinedAt is int;
        allow update, delete: if false;
      }
    }

    // Diğer her şey kapalı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
